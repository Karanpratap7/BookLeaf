generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role
  authorId      String?   @map("author_id")
  phone         String?
  city          String?
  joinedDate    DateTime  @defaultNow @map("joined_date")
  books         Book[]
  tickets       Ticket[]
  createdAt     DateTime  @defaultNow
  updatedAt     DateTime  @updatedAt
}

enum Role {
  AUTHOR
  ADMIN
}

model Book {
  id            String    @id @default(uuid())
  title         String
  isbn          String?
  genre         String?
  publicationDate DateTime?
  status        String?
  mrp           Float?
  authorRoyaltyPerCopy Float?
  totalCopiesSold Integer
  totalRoyaltyEarned Integer
  royaltyPaid   Integer
  royaltyPending Integer
  lastRoyaltyPayoutDate DateTime?
  printPartner  String?
  availableOn     Json?
  author        User?     @relation(fields: [authorId], references: [id])
  authorId      String?   @map("author_id")
  tickets       Ticket[]
  createdAt     DateTime  @defaultNow
  updatedAt     DateTime  @updatedAt
}

model Ticket {
  id            String    @id @default(uuid())
  author        User      @relation(fields: [authorId], references: [id])
  authorId      String
  book          Book?     @relation(fields: [bookId], references: [id])
  bookId        String?
  subject       String
  description   String
  status        String
  category      String
  priority      String
  categoryOverride String?   @map("category_override")
  priorityOverride String?   @map("priority_override")
  assignedAdmin   User?     @relation("AdminAssignment", fields: [assignedAdminId], references: [id])
  assignedAdminId String?
  createdAt     DateTime  @defaultNow
  updatedAt     DateTime  @updatedAt
  messages      TicketMessage[]
  internalNotes   InternalNote[]
}

model TicketMessage {
  id        String @id @default(uuid())
  ticket    Ticket @relation(fields: [ticketId], references: [id])
  ticketId  String
  senderRole Role
  body      String
  createdAt DateTime @defaultNow
}

model InternalNote {
  id        String @id @default(uuid())
  ticket    Ticket @relation(fields: [ticketId], references: [id])
  ticketId  String
  admin     User   @relation(fields: [adminId], references: [id])
  adminId   String
  body      String
  createdAt DateTime @defaultNow
}

model KbChunk {
  id            String    @id @default(uuid())
  category      String?   @map("category")
  title         String
  content       String
  embedding     Json?
  createdAt     DateTime  @defaultNow
}